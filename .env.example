# Copy to .env and fill in real values.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-random-hex

ADMIN_USERNAME=admin

# Generate with: python backend/hash_password.py
ADMIN_PASSWORD_HASH=replace-with-argon2-hash

DB_PATH=/var/lib/portforward/rules.db

# Set to 1 to test without actually running iptables (no root needed)
DRY_RUN=0
