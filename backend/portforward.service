[Unit]
Description=Port Forward Dashboard
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/portforward-dashboard/backend
EnvironmentFile=/opt/portforward-dashboard/.env
ExecStart=/opt/portforward-dashboard/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
